# ventas.dakagency.net — DAK Sales Control Center.
#
# El muro ya no es Basic Auth: es la sesion de Google que gestiona index.php.
# Y es un muro de verdad, no un login pintado en el navegador — el build vive
# en app/, que este archivo bloquea por completo, asi que el unico camino hacia
# el HTML y el JavaScript pasa por la comprobacion de sesion.
#
# Aqui dentro hay nombres de empresas prospecto, telefonos y mensajes de venta
# sin enviar.

DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dotfiles y archivos de servicio, fuera. Va primero de todo.
  RewriteRule (^|/)\. - [F,L]
  RewriteRule \.(tar\.gz|tgz|sql|zip|bak|csv)$ - [F,L]

  # app/ NO se sirve nunca directamente. Es donde vive el build, y llegar ahi
  # sin pasar por index.php seria saltarse la puerta entera.
  RewriteRule ^app(/|$) - [F,L]

  # Todo lo demas —incluidas /inicio, /hoy y los assets— entra por index.php,
  # que comprueba la sesion y decide si sirve el archivo o la pantalla de acceso.
  #
  # robots.txt queda exento y se sirve tal cual, sin sesion: es lo que un
  # rastreador viene a leer, y decirle que se vaya es mas util que darle un 401.
  # Se EXCLUYE en vez de reescribirlo a app/, porque una reescritura vuelve a
  # entrar en este ruleset y la corta la regla que protege app/.
  RewriteCond %{REQUEST_URI} !^/(index\.php|robots\.txt)$
  RewriteRule . /index.php [L]
</IfModule>

# El config y la pantalla de acceso son includes de PHP, no paginas sueltas.
<FilesMatch "^(config|acceso)\.php$">
  Require all denied
</FilesMatch>
