# bitacora.dakagency.net — DAK Bitácora.
#
# El muro es la sesion de Google que gestiona index.php, y es un muro de verdad,
# no un login pintado en el navegador: el build vive en app/ y el codigo del
# servidor en lib/, y este archivo bloquea las dos carpetas por completo. El
# unico camino hacia el HTML, el JavaScript y la API pasa por la comprobacion
# de sesion.
#
# Aqui dentro hay el detalle operativo de como trabaja una persona concreta.
# Eso no se sirve sin sesion ni se indexa.

DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dotfiles y archivos de servicio, fuera. Va primero de todo.
  RewriteRule (^|/)\. - [F,L]
  RewriteRule \.(tar\.gz|tgz|sql|zip|bak|csv|env)$ - [F,L]

  # app/ y lib/ NO se sirven nunca directamente. Ahi viven el build y el codigo
  # del servidor; llegar sin pasar por index.php seria saltarse la puerta entera.
  RewriteRule ^app(/|$) - [F,L]
  RewriteRule ^lib(/|$) - [F,L]

  # Todo lo demas —incluidas /hoy, /cierre, /api/... y los assets— entra por
  # index.php, que comprueba la sesion y decide si sirve el archivo, despacha la
  # API o enseña la pantalla de acceso.
  #
  # robots.txt queda exento y se sirve tal cual, sin sesion: es lo que un
  # rastreador viene a leer, y decirle que se vaya es mas util que darle un 401.
  # Se EXCLUYE en vez de reescribirlo a app/, porque una reescritura vuelve a
  # entrar en este ruleset y la corta la regla que protege app/.
  #
  # tipo/ lleva la tipografia y tambien queda exenta, porque hace falta que sea
  # alcanzable SIN sesion: la pantalla de acceso se sirve precisamente a quien
  # no la tiene, asi que con la fuente tras el muro la puerta se dibujaria con
  # la letra del sistema mientras la aplicacion de dentro usa la suya. Es un
  # woff2 y un png de grano: material publico que no revela nada. El patron
  # admite SOLO esas dos extensiones y solo nombres planos, no una ruta libre.
  RewriteCond %{REQUEST_URI} !^/(index\.php|robots\.txt)$
  RewriteCond %{REQUEST_URI} !^/tipo/[A-Za-z0-9._-]+\.(woff2|png)$
  RewriteRule . /index.php [L]
</IfModule>

# El config y la pantalla de acceso son includes de PHP, no paginas sueltas.
<FilesMatch "^(config|acceso)\.php$">
  Require all denied
</FilesMatch>
