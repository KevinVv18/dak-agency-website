# edificios.dakagency.net: showroom estático detrás de un portero en PHP
# (lo copia generar.js a dist/.htaccess; el portero es servidor/acceso.php).
Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Presentación privada: todo pasa por acceso.php, que solo entrega con un pase
# vigente (invitación con vencimiento o clave de presentación). Quedan libres
# la tipografía y la flor, que usa la propia pantalla de acceso.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^acceso\.php$ - [L]
  RewriteRule ^vendor/(fonts/archivo-latin-var\.woff2|flor\.svg)$ - [L]
  RewriteRule ^(.*)$ acceso.php?ruta=$1 [L,QSA]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
